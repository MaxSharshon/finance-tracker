@page "/categories"

<PageTitle>Categories</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Configuration</span>
        <h1>Categories</h1>
        <p>Organize operations into income and expense groups for reporting.</p>
    </div>
    <button class="btn btn-primary" @onclick="StartCreate"><span class="bi bi-plus-lg"></span> New category</button>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p class="validation-message">@_errorMessage</p>
}
@if (!string.IsNullOrWhiteSpace(_successMessage))
{
    <p class="stat-note">@_successMessage</p>
}

<section class="panel">
    <div class="panel-header">
        <h2>Category list</h2>
        <span class="badge">@_categories.Count categories</span>
    </div>

    @if (_isLoading)
    {
        <div class="empty-state">Loading categories...</div>
    }
    else if (_categories.Count == 0)
    {
        <div class="empty-state">No categories yet.</div>
    }
    else
    {
        <table class="data-table">
            <thead>
            <tr>
                <th>Name</th>
                <th>Type</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var category in _categories)
            {
                <tr>
                    <td>@category.Name</td>
                    <td><span class="badge @(category.OperationType == "Income" ? "success" : "danger")">@category.OperationType</span></td>
                    <td class="actions">
                        <button class="btn btn-secondary" disabled="@_isSaving" @onclick="() => StartEdit(category)">Edit</button>
                        <button class="btn btn-danger" disabled="@_isSaving" @onclick="() => DeleteAsync(category.Id)">
                            @(_deletingId == category.Id ? "Deleting..." : "Delete")
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>

<section class="form-panel">
    <div class="panel-header">
        <h2>@(_editingId.HasValue ? "Edit category" : "Create category")</h2>
    </div>
    <div class="panel-body">
        <EditForm Model="_form" OnValidSubmit="SaveAsync" FormName="CategoryForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid two">
                <div class="field">
                    <label>Name</label>
                    <InputText class="input" @bind-Value="_form.Name" />
                </div>
                <div class="field">
                    <label>Operation type</label>
                    <InputSelect class="select" @bind-Value="_form.OperationType">
                        <option value="Expense">Expense</option>
                        <option value="Income">Income</option>
                    </InputSelect>
                </div>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-secondary" disabled="@_isSaving" @onclick="StartCreate">Clear</button>
                <button type="submit" class="btn btn-primary" disabled="@_isSaving">
                    @(_isSaving ? "Saving..." : "Save category")
                </button>
            </div>
        </EditForm>
    </div>
</section>
