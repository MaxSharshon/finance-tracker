@page "/balance-changes/create"

<h3>Create New</h3>

<EditForm Model="_newBalanceChange" 
          OnValidSubmit="HandleValidSubmit"
          FormName="CreateBalanceChangeForm">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div>
        <label>Operation Type:</label>
        <InputSelect @bind-Value="_newBalanceChange.OperationType">
            @foreach (var option in _operationTypeOptions)
            {
                <option value="@option">@option</option>
            }
        </InputSelect>
        <ValidationMessage For="() => _newBalanceChange.OperationType" />
    </div>
    
    <div>
        <label>Amount:</label>
        <InputNumber @bind-Value="_newBalanceChange.Amount" />
        <ValidationMessage For="() => _newBalanceChange.Amount" />
    </div>
    
    <button type="submit">Create</button>
</EditForm>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <p style="color: red">@_errorMessage</p>
}