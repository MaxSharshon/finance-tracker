@page "/reports/daily"

<PageTitle>Daily Report</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Reports</span>
        <h1>Daily report</h1>
        <p>Review one day of income, expenses, and operation details.</p>
    </div>
    <a class="btn btn-secondary" href="reports/date-period">Period report</a>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p class="validation-message">@_errorMessage</p>
}

<section class="panel">
    <div class="panel-header">
        <h2>Report parameters</h2>
        <button class="btn btn-primary" type="submit" form="DailyReportForm">Generate</button>
    </div>
    <div class="panel-body">
        <EditForm Model="_form" OnValidSubmit="FetchReport" FormName="DailyReportForm" id="DailyReportForm">
            <div class="form-grid single">
                <div class="field compact">
                    <label>Date</label>
                    <InputDate class="input" @bind-Value="_form.Date" />
                </div>
            </div>
        </EditForm>
    </div>
</section>

<section class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Income</div>
        <div class="stat-value income">@FormatMoney(_report?.TotalIncome ?? 0)</div>
        <div class="stat-note">Selected date</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Expenses</div>
        <div class="stat-value expense">@FormatMoney(_report?.TotalExpenses ?? 0)</div>
        <div class="stat-note">Selected date</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Net result</div>
        <div class="stat-value">@FormatMoney(NetTotal)</div>
        <div class="stat-note">@_form.Date.ToString("dd MMM yyyy")</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Operations</div>
        <div class="stat-value">@OperationsCount</div>
        <div class="stat-note">Loaded from API</div>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <h2>Operations</h2>
        <span class="badge">@OperationsCount records</span>
    </div>

    @if (_report is null)
    {
        <div class="empty-state">Generate report to see operations.</div>
    }
    else if (!_report.Operations.Any())
    {
        <div class="empty-state">No operations for this date.</div>
    }
    else
    {
        <table class="data-table">
            <thead>
            <tr>
                <th>Date</th>
                <th>Category</th>
                <th>Description</th>
                <th>Budget</th>
                <th>Amount</th>
            </tr>
            </thead>
            <tbody>
            @foreach (var operation in _report.Operations.OrderByDescending(operation => operation.Date))
            {
                var type = GetOperationType(operation.CategoryId);
                <tr>
                    <td>@operation.Date.ToString("dd MMM yyyy")</td>
                    <td>@GetCategoryName(operation.CategoryId)</td>
                    <td>@operation.Description</td>
                    <td>@GetBudgetName(operation.BudgetId)</td>
                    <td class="@GetAmountClass(type)">@FormatSignedMoney(operation.Amount, type)</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
