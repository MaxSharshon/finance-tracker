@page "/reports/daily"

<h3>Daily Report</h3>

<EditForm Model="_selectedDate"
          OnValidSubmit="FetchReport"
          FormName="SetDateForDailyReportPage">
    <label>Select date:</label>
    <InputDate @bind-Value="_selectedDate"/>
    <button type="submit">Generate Report</button>
</EditForm>


@if (_report != null)
{
    <h4>Summary for @_report.Date.ToShortDateString()</h4>
    <p><strong>Total Income: </strong>@_report.TotalIncome</p>
    <p><strong>Total Expenses: </strong>@_report.TotalExpenses</p>
    
    <h5>Operations</h5>
    @if (_report.Operations.Any())
    {
        <ul>
            @foreach (var operation in _report.Operations)
            {
                <li>@operation.Date - @operation.BalanceChangeId</li>
            }
        </ul>
    }
    else
    {
        <p>No operations for this date.</p>
    }
}

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <p style="color: red">@_errorMessage</p>
}