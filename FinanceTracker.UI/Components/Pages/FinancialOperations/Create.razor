@page "/financial-operations/create"

<PageTitle>New financial operation</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Transactions</span>
        <h1>New financial operation</h1>
        <p>Add income or expense to a personal account or shared budget.</p>
    </div>
    <button class="btn btn-secondary" @onclick="GoToListing">Back to list</button>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p class="validation-message">@_errorMessage</p>
}

<section class="form-panel operation-form">
    <div class="panel-header">
        <h2>Operation details</h2>
        <span class="badge">Draft</span>
    </div>
    <div class="panel-body">
        <EditForm Model="_operation" OnValidSubmit="HandleValidSubmit" FormName="CreateFinancialOperationForm">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-grid two">
                <div class="field">
                    <label>Date</label>
                    <InputDate class="input" @bind-Value="_operation.Date" />
                </div>
                <div class="field">
                    <label>Category</label>
                    <InputSelect class="select" @bind-Value="_operation.CategoryId">
                        <option value="">Select category</option>
                        @foreach (var category in _categories)
                        {
                            <option value="@category.Id">@category.Name (@category.OperationType)</option>
                        }
                    </InputSelect>
                </div>
                <div class="field">
                    <label>Amount</label>
                    <InputNumber class="input" @bind-Value="_operation.Amount" />
                </div>
                <div class="field">
                    <label>Budget</label>
                    <InputSelect class="select" @bind-Value="_operation.BudgetId">
                        <option value="">Personal</option>
                        @foreach (var budget in _budgets)
                        {
                            <option value="@budget.Id">@budget.Name</option>
                        }
                    </InputSelect>
                </div>
            </div>

            <div class="field tag-field">
                <label>Tags</label>
                <div class="tag-picker">
                    @foreach (var tag in _tags)
                    {
                        <label class="tag-option">
                            <input type="checkbox"
                                   checked="@_operation.TagIds.Contains(tag.Id)"
                                   @onchange="args => ToggleTag(tag.Id, (bool)(args.Value ?? false))" />
                            @tag.Name
                        </label>
                    }
                </div>
            </div>

            <div class="field">
                <label>Description</label>
                <InputTextArea class="textarea" @bind-Value="_operation.Description" />
            </div>
            
            @if (!string.IsNullOrWhiteSpace(_suggestionMessage))
            {
                <div class="suggestion-note">@_suggestionMessage</div>
            }
            
            <div class="form-actions end">
                <button type="button" class="btn btn-secondary" @onclick="SuggestCategoryAsync">Suggest category</button>
                <button type="button" class="btn btn-secondary" @onclick="GoToListing">Cancel</button>
                <button type="submit" class="btn btn-primary">Save operation</button>
            </div>
        </EditForm>
    </div>
</section>
