@page "/financial-operations"
@using FinanceTracker.Contracts.Enums

<PageTitle>Financial Operations</PageTitle>

<div class="page-head">
    <div>
        <span class="eyebrow">Transactions</span>
        <h1>Financial operations</h1>
        <p>Review, filter, and manage personal and shared budget transactions.</p>
    </div>
    <button class="btn btn-primary" @onclick="NavigateToCreate"><span class="bi bi-plus-lg"></span> Add operation</button>
</div>

@if (!string.IsNullOrWhiteSpace(_errorMessage))
{
    <p class="validation-message">@_errorMessage</p>
}

<section class="panel">
    <div class="panel-header">
        <h2>Filters</h2>
        <button class="btn btn-secondary" disabled="@_isLoading" @onclick="ApplyFiltersAsync">Apply filters</button>
    </div>
    <div class="panel-body">
        <div class="form-grid four">
            <div class="field">
                <label>Start date</label>
                <InputDate class="input" @bind-Value="_filter.StartDate" />
            </div>
            <div class="field">
                <label>End date</label>
                <InputDate class="input" @bind-Value="_filter.EndDate" />
            </div>
            <div class="field">
                <label>Type</label>
                <InputSelect class="select" @bind-Value="_filter.OperationType">
                    <option value="">All types</option>
                    <option value="@OperationType.Income">Income</option>
                    <option value="@OperationType.Expense">Expense</option>
                </InputSelect>
            </div>
            <div class="field">
                <label>Category</label>
                <InputSelect class="select" @bind-Value="_filter.CategoryId">
                    <option value="">All categories</option>
                    @foreach (var category in _categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </InputSelect>
            </div>
        </div>
    </div>
</section>

<section class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Income</div>
        <div class="stat-value income">@FormatMoney(IncomeTotal)</div>
        <div class="stat-note">Selected operations</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Expenses</div>
        <div class="stat-value expense">@FormatMoney(ExpenseTotal)</div>
        <div class="stat-note">Selected operations</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Net result</div>
        <div class="stat-value">@FormatMoney(NetTotal)</div>
        <div class="stat-note">Income minus expenses</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Operations</div>
        <div class="stat-value">@_operations.Count</div>
        <div class="stat-note">Loaded from API</div>
    </div>
</section>

<section class="panel">
    <div class="panel-header">
        <h2>Operations list</h2>
        <span class="badge">@_operations.Count records</span>
    </div>

    @if (_isLoading)
    {
        <div class="empty-state">Loading operations...</div>
    }
    else if (_operations.Count == 0)
    {
        <div class="empty-state">No financial operations found.</div>
    }
    else
    {
        <table class="data-table">
            <thead>
            <tr>
                <th>Date</th>
                <th>Category</th>
                <th>Type</th>
                <th>Description</th>
                <th>Budget</th>
                <th>Tags</th>
                <th>Amount</th>
                <th></th>
            </tr>
            </thead>
            <tbody>
            @foreach (var operation in _operations.OrderByDescending(operation => operation.Date))
            {
                var type = GetOperationType(operation.CategoryId);
                <tr>
                    <td>@operation.Date.ToString("dd MMM yyyy")</td>
                    <td>@GetCategoryName(operation.CategoryId)</td>
                    <td><span class="badge @GetBadgeClass(type)">@type</span></td>
                    <td>@operation.Description</td>
                    <td>@GetBudgetName(operation.BudgetId)</td>
                    <td>@GetTagNames(operation.TagIds)</td>
                    <td class="@GetAmountClass(type)">@FormatSignedMoney(operation.Amount, type)</td>
                    <td class="actions">
                        <button class="btn btn-secondary" @onclick="() => NavigateToEdit(operation.Id)">Edit</button>
                        <button class="btn btn-danger" disabled="@(_deletingId == operation.Id)" @onclick="() => DeleteAsync(operation.Id)">
                            @(_deletingId == operation.Id ? "Deleting..." : "Delete")
                        </button>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
