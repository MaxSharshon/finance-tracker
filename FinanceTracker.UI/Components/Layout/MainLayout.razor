@inherits LayoutComponentBase

<div class="app-shell">
    <aside class="app-sidebar">
        <NavMenu />
    </aside>

    <main class="app-main">
        <header class="app-header">
            <div>
                <span class="eyebrow">Personal finance workspace</span>
                <strong>FinanceTracker</strong>
            </div>

            @if (AuthClient.IsAuthenticated)
            {
                <div class="header-actions">
                    <div class="header-menu">
                        <button class="icon-button" type="button" aria-label="Notifications">
                            <span class="bi bi-bell"></span>
                            @if (UnreadNotificationsCount > 0)
                            {
                                <span class="notification-dot"></span>
                            }
                        </button>
                        <div class="dropdown-panel notifications-panel">
                            <div class="dropdown-head">
                                <strong>Notifications</strong>
                                <span class="badge-count">@UnreadNotificationsCount new</span>
                            </div>
                            @if (!HeaderNotifications.Any())
                            {
                                <div class="notification-empty">No unread notifications.</div>
                            }
                            else
                            {
                                @foreach (var notification in HeaderNotifications)
                                {
                                    <a class="notification-item" href="notifications">
                                        <span class="item-icon warning">
                                            <span class="bi bi-bell"></span>
                                        </span>
                                        <span>
                                            <strong>Unread notification</strong>
                                            <small>@notification.Message</small>
                                        </span>
                                    </a>
                                }
                            }
                            <a class="dropdown-footer" href="notifications">View all notifications</a>
                        </div>
                    </div>

                    <div class="header-menu">
                        <button class="account-button" type="button" aria-label="Account menu">
                            <span class="user-pill">@UserInitials</span>
                            <span class="account-name">@DisplayUserName</span>
                            <span class="bi bi-chevron-down"></span>
                        </button>
                        <div class="dropdown-panel account-panel">
                            <div class="account-summary">
                                <span class="user-pill">@UserInitials</span>
                                <span>
                                    <strong>@DisplayUserName</strong>
                                    <small>@DisplayUserEmail</small>
                                </span>
                            </div>
                            <a class="menu-item" href="budgets"><span class="bi bi-people"></span> Shared budgets</a>
                            <button class="menu-item" type="button" @onclick="SignOut"><span class="bi bi-box-arrow-right"></span> Sign out</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="header-actions">
                    <a class="auth-link" href="login">Sign in</a>
                    <a class="auth-link primary" href="register">Create account</a>
                </div>
            }
        </header>

        <section class="app-content">
            @Body
        </section>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">x</span>
</div>
